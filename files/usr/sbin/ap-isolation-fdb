#!/bin/sh
# ap-isolation-fdb - opt-in qca8k stale-ATU roaming workaround (openwrt#25365).
#
# For each station associating to an isolated AP interface, pin a static
# bridge FDB entry for it on that interface, and remove it on disassociation.
# The static entry makes the bridge re-program the switch so the stale dynamic
# ATU entry left pointing at the wired uplink after a roam is purged (the same
# thing "bridge fdb replace ... master static" does by hand).
#
# Enable with:
#   uci set ap-isolation.settings.fdb_workaround='1'
#   uci commit ap-isolation && /etc/init.d/ap-isolation-fdb restart
#
# 'ap-isolation-fdb cleanup' removes every entry this daemon pinned (tracked in
# PINS) from both the station's interface and 'wan'. It runs on start (clear a
# previous run's leftovers) and on service stop.
#
# NOTE: the pins are static. If the daemon is killed hard, leftovers are cleared
# by the next start/stop cleanup. Treat this as experimental.

. /lib/functions.sh

PROG=ap-isolation-fdb
PINS=/tmp/ap-isolation-fdb.pins

IFACES=""
_collect() {
	local section="$1" iso ifname
	config_get iso "$section" isolate
	[ "$iso" = "1" ] || return
	config_get ifname "$section" ifname
	[ -n "$ifname" ] && IFACES="$IFACES $ifname"
}

config_load ap-isolation
config_get_bool e settings enabled 0
config_get_bool wu settings fdb_workaround 0
config_get vlan_id settings vlan_id

VL=""
[ -n "$vlan_id" ] && [ "$vlan_id" != "0" ] && VL="vlan $vlan_id"

config_load wireless
config_foreach _collect wifi-iface

_del_entry() {
	bridge fdb del "$1" dev "$2" $VL master static 2>/dev/null
}

do_cleanup() {
	[ -f "$PINS" ] || return 0
	while read -r iface mac; do
		[ -n "$mac" ] || continue
		_del_entry "$mac" "$iface"
		_del_entry "$mac" wan
	done < "$PINS"
	rm -f "$PINS"
}

case "${1:-}" in
	cleanup) do_cleanup; exit 0 ;;
esac

[ "$e" = "1" ] && [ "$wu" = "1" ] || { logger -t "$PROG" "disabled"; do_cleanup; exit 0; }
[ -n "$IFACES" ] || { logger -t "$PROG" "no isolated interfaces"; exit 0; }

_is_ours() {
	local i
	for i in $IFACES; do [ "$i" = "$1" ] && return 0; done
	return 1
}

# clear leftovers from a previous run before pinning again
do_cleanup
logger -t "$PROG" "watching iw events for:$IFACES"

iw event | while IFS= read -r line; do
	case "$line" in
		*": new station "*)
			iface="${line%%:*}"; mac="${line##* }"
			if _is_ours "$iface"; then
				if bridge fdb replace "$mac" dev "$iface" $VL master static 2>/dev/null; then
					echo "$iface $mac" >> "$PINS"
					logger -t "$PROG" "pinned $mac on $iface"
				fi
			fi
			;;
		*": del station "*)
			iface="${line%%:*}"; mac="${line##* }"
			if _is_ours "$iface"; then
				_del_entry "$mac" "$iface"
				_del_entry "$mac" wan
				grep -vix "$iface $mac" "$PINS" > "$PINS.tmp" 2>/dev/null && mv "$PINS.tmp" "$PINS"
				logger -t "$PROG" "unpinned $mac on $iface"
			fi
			;;
	esac
done
