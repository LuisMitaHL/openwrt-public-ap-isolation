config ap_isolation 'settings'
	option enabled '0'
	# Isolation tier: 'filter' (ARP/broadcast/multicast filtering, default) or
	# 'gateway' (default-drop gateway allowlist; requires gateway_ip + gateway_mac).
	option mode 'filter'
	option vlan_id ''
	option gateway_ip ''
	option gateway_mac ''
	option ipv6_enabled '0'
	# Experimental qca8k stale-ATU roaming workaround (pin static bridge FDB
	# entries on STA association). See /usr/sbin/ap-isolation-fdb.
	option fdb_workaround '0'
