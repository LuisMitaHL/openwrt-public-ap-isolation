#!/bin/sh /etc/rc.common

START=81
STOP=29
USE_PROCD=1

PROG=/usr/sbin/ap-isolation-fdb

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "ap-isolation"
}

reload_service() {
	stop
	start
}
